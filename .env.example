# Скопировать в .env и заполнить. .env в git не попадает.

PORT=3210
PUBLIC_BASE_URL=https://smm.mycomputer.education

# Вход в планировщик (basic-сессия, один общий логин на команду)
AUTH_USER=smm
AUTH_PASSWORD=

# --- Telegram: работает сразу, без проверок ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Threads: токен живёт 60 дней, обновляется автоматически ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Meta (Instagram + Facebook), одно приложение на обе площадки ---
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=

# --- TikTok: до аудита публикует только приватно ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
