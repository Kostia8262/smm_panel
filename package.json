{
  "name": "smm-autopost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Планировщик и автопостинг в Telegram, Threads, Instagram, Facebook, TikTok",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
